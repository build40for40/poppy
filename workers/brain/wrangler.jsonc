{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poppy-brain",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "compatibility_date": "2026-11-04",
  "main": "src/index.ts",
  "vars": {
    "LIVE_MODEL": "claude-sonnet-5-5",
    "WHATSAPP_API_VERSION": "v27.0",
    // "true" replies with the user's own text and never calls Claude. Set it in .dev.vars to test the WhatsApp round trip.
    "ECHO_MODE": "",
    // Only for Twilio behind a tunnel: the tunnel's address, so the signature check knows the URL Twilio called.
    "PUBLIC_BASE_URL": "",
    // "true" sends the reply to a Twilio message back in the webhook's own answer (TwiML) and not through Twilio's API.
    // It's on because the Twilio account can't send through the API until its compliance profile is approved. A reply
    // that takes longer than Twilio waits, and the check-in nudge, still go through the API. Set it to "" once sending works.
    "TWILIO_REPLY_INLINE": "true",
    // "true" switches on the demo chat the landing page talks to, at /poppy/api/web. It's public and unsigned, so it's
    // capped: a few messages per visitor, a ceiling per day, and each visitor's brain is deleted after a day.
    "WEB_CHAT": "true",
    // Where Twilio and Meta fetch the picture on a suggestion. They fetch it themselves, so it has to be public.
    "PICTURES_BASE_URL": "https://build40for40.com/poppy/api/pictures"
  },
  // Secrets, set with `wrangler secret put` or the deploy workflow, and in .dev.vars locally:
  //   ANTHROPIC_API_KEY
  //   Meta:   WHATSAPP_APP_SECRET, WHATSAPP_TOKEN, WHATSAPP_VERIFY_TOKEN, WHATSAPP_PHONE_NUMBER_ID
  //   Twilio: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM
  // There's no "secrets.required" list on purpose. Messages come in through Meta or through Twilio, so neither provider's
  // secrets can be required, and a list would stop `wrangler dev` loading the unlisted ones from .dev.vars. A route answers
  // 503 until its own are set. They're typed in src/env.d.ts.
  "durable_objects": {
    "bindings": [
      { "name": "USER_BRAIN", "class_name": "UserBrain" },
      { "name": "PICTURE_SHELF", "class_name": "PictureShelf" },
      { "name": "WEB_GATE", "class_name": "WebGate" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserBrain"] },
    { "tag": "v2", "new_sqlite_classes": ["PictureShelf"] },
    { "tag": "v3", "new_sqlite_classes": ["WebGate"] }
  ],
  // The landing page is one HTML file, bundled in as text and served at /poppy.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "routes": [
    // One pattern with the star at the end, because a route is matched against the whole address, query string included:
    // "/poppy" on its own doesn't match "/poppy?fbclid=…", which is how shared links arrive. It covers the landing page,
    // /poppy/ and everything under /poppy/api. Any other path gets the Worker's own 404.
    { "pattern": "build40for40.com/poppy*", "zone_name": "build40for40.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
