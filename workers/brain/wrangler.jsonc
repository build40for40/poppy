{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poppy-brain",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "compatibility_date": "2026-11-04",
  "main": "src/index.ts",
  "vars": {
    "LIVE_MODEL": "claude-sonnet-5-5",
    "WHATSAPP_API_VERSION": "v27.0",
    // "true" replies with the user's own text and never calls Claude. Set it in .dev.vars to test the WhatsApp round trip.
    "ECHO_MODE": ""
  },
  "secrets": {
    "required": ["ANTHROPIC_API_KEY", "WHATSAPP_APP_SECRET", "WHATSAPP_TOKEN", "WHATSAPP_VERIFY_TOKEN", "WHATSAPP_PHONE_NUMBER_ID"]
  },
  "durable_objects": {
    "bindings": [{ "name": "USER_BRAIN", "class_name": "UserBrain" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserBrain"] }],
  "routes": [
    { "pattern": "build40for40.com/poppy/api", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/poppy/api/*", "zone_name": "build40for40.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
